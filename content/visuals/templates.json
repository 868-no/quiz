              "properties": {
                "ohms": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 10000000,
                  "unit": "Ω"
                },
                "show_value": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          },
          "ammeter": {
            "type": "object",
            "nullable": true,
            "properties": {
              "branch": {
