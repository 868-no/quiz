            "properties": {
              "across": {
                "type": "string",
                "enum": [
                  "source",
                  "R1",
                  "R2",
                  "R3"
                ]
              },
              "show_reading": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "show_current_direction": {
            "type": "boolean",
            "default": false
          },
          "animate_current": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
