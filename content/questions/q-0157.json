        "s3-29"
      ],
      "topic_ids": [
        "felteffekttransistorer"
      ],
      "learning_objective": "Skille mellom felteffekttransistorer i tømmingsmodus og forsterkningsmodus.",
      "priority": "normal",
      "context": [
        [
          "To N-kanal-",
          {
            "term": "felteffekttransistor",
            "text": "MOSFET"
          },
          "-er får samme positive spenning mellom drain og source. ",
          {
            "term": "spenning",
            "text": "Spenningen"
          },
          " mellom gate og source er 0 V på begge. Den ene er laget for ",
          {
            "term": "tommingsmodus",
            "text": "tømmingsmodus"
          },
          " (depletion mode), den andre for ",
          {
            "term": "forsterkningsmodus",
            "text": "forsterkningsmodus"
          },
          " (enhancement mode)."
        ]
      ],
      "stem": [
        "Hva er det mest sannsynlige resultatet?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Bare den i tømmingsmodus leder nevneverdig; den andre trenger positiv gatespenning."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Bare den i forsterkningsmodus leder nevneverdig; den andre trenger positiv gatespenning."
          ],
          "feedback": [
            "Det er omvendt. Tømmingsmodus har en åpen kanal allerede ved 0 V og styres ved å gjøre gate negativ."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Begge leder like mye, fordi gate ikke trekker strøm og derfor ikke påvirker kanalen."
          ],
          "feedback": [
            "Gate trekker nesten ingen strøm, men spenningen på gate styrer kanalen. De to typene er bygd ulikt og oppfører seg ulikt ved 0 V."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Ingen av dem leder før gate gjøres negativ i forhold til source."
          ],
          "feedback": [
            "På en N-kanal-FET gjør negativ gatespenning tømmingssjiktet bredere og kanalen smalere. Det reduserer strømmen i stedet for å starte den."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "I ",
          {
            "term": "tommingsmodus",
            "text": "tømmingsmodus"
          },
          " finnes det en ledende kanal mellom drain og source selv når gate ligger på 0 V. Gjøres gate negativ, vokser ",
          {
            "term": "sperresjikt",
            "text": "tømmingssjiktet"
          },
          " inn i kanalen og ",
          {
            "term": "strom",
            "text": "strømmen"
          },
          " avtar, helt til kanalen knipes av."
        ],
        [
          "I en MOSFET av forsterkningstypen finnes det normalt ingen ledende kanal mellom drain og source når gatespenningen er 0 V. Når gate gjøres tilstrekkelig positiv i forhold til source, dannes en ledende kanal, og ",
          {
            "term": "transistor",
            "text": "transistoren"
          },
          " kan føre strøm."
        ],
        [
          "Derfor vil MOSFET-en i tømmingsmodus normalt lede ved 0 V gatespenning, mens MOSFET-en i ",
          {
            "term": "forsterkningsmodus",
            "text": "forsterkningsmodus"
          },
          " normalt er sperret."
        ]
      ],
      "glossary_after_answer": [
        "forsterkningsmodus",
        "tommingsmodus"
      ],
      "study_reference": {
        "chapter": 3,
        "section_id": "s3-29",
        "printed_pages": [
          "3-12",
          "3-13"
        ]
      },
