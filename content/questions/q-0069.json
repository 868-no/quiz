      "learning_objective": "Beregne effekten som avgis i en transistor ut fra spenningen over den og strømmen gjennom den.",
      "priority": "normal",
      "context": [
        [
          "En NPN-transistor er forspent slik at kollektorstrømmen er ",
          {
            "q": 15,
            "u": "mA"
          },
          " når det ikke er noe signal. Forsyningsspenningen er ",
          {
            "q": 12,
            "u": "V"
          },
          ", emitteren ligger direkte på jord, og kollektoren er koblet til forsyningen gjennom en kollektormotstand og ligger på ",
          {
            "q": 6,
            "u": "V"
          },
          " i forhold til jord. Se bort fra effekten som skyldes basisstrømmen."
        ]
      ],
      "stem": [
        "Hvor stor effekt avgis som varme i transistoren?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            {
              "q": 90,
              "u": "mW"
            }
          ],
          "feedback": []
