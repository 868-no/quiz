      ],
      "stem": [
        [
          "Hvor mye mer dempes et signal på ",
          {
            "q": 3.5,
            "u": "MHz"
          },
          " enn et på ",
          {
            "q": 7,
            "u": "MHz"
          },
          " når alt annet er likt?"
