      "topic_ids": [
        "resonans"
      ],
      "learning_objective": "Forstå hva som kjennetegner serieresonans.",
      "priority": "exam_important",
      "context": [
        [
          "En spole og en kondensator er koblet i serie med en signalkilde. Frekvensen justeres til kretsens ",
          {
            "term": "resonans",
            "text": "resonansfrekvens"
          },
          ". Spolen og kondensatoren regnes som ideelle, men kretsen har en liten resistans (for eksempel i kilden)."
        ]
      ],
      "stem": [
        "Hva kjennetegner kretsen ved denne frekvensen?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Spolens og kondensatorens reaktanser er like store."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Strømmen i kretsen er minst mulig."
          ],
          "feedback": [
            "For en seriekrets er det omvendt. Reaktansene opphever hverandre, og strømmen blir størst."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Spolens reaktans er null."
          ],
          "feedback": [
            "Spolens reaktans er bare null ved 0 Hz. Ved resonans er den like stor som kondensatorens."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Spenningen over kondensatoren er null."
          ],
          "feedback": [
            "Spenningene over L og C er like store og i motfase, så de opphever hverandre. Hver for seg er de ikke null; de kan til og med være større enn kildespenningen."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          {
            "math": [
              "X_L",
              "=",
              "X_C"
            ]
          },
          " ved resonans. Spenningen over spolen ligger 90° foran strømmen, og spenningen over kondensatoren 90° etter. De er altså i motfase (180°) og like store, så summen blir null."
        ],
        "Kretsen har da ingen samlet reaktans. Strømmen begrenses bare av kretsens resistans, og blir størst ved resonansfrekvensen."
      ],
      "glossary_after_answer": [
        "resonans"
      ],
