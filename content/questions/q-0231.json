                "·",
                "10^6",
                {
                  "unit": "Hz"
                }
              ]
            }
          ],
          "feedback": [
            "10⁶ er prefikset mega alene. Når 145 skrives som 1,45, flyttes kommaet to plasser til, så eksponenten øker med 2."
          ]
        },
        {
          "id": "o3",
          "content": [
