            "u": "MHz"
          },
          ". I en utregning skal den skrives i hertz med tierpotens."
        ]
      ],
      "stem": [
        "Hvordan skrives 145 MHz i hertz?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            {
              "math": [
                "1,45",
                "·",
                "10^8",
