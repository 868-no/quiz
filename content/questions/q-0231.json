                {
                  "unit": "Hz"
                }
              ]
            }
          ],
          "feedback": [
            "Det er 1,45 GHz, ti ganger for mye. 145 MHz er 145 · 10⁶ Hz, som blir 1,45 · 10⁸ Hz."
          ]
        },
        {
          "id": "o4",
          "content": [
            {
              "math": [
                "1,45",
