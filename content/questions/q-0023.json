        "ssb"
      ],
      "learning_objective": "Forstå hvorfor SSB bruker mindre båndbredde enn AM.",
      "priority": "normal",
      "context": [],
      "stem": [
        [
          "Hvorfor opptar et ",
          {
            "term": "ssb",
            "text": "SSB"
          },
          "-signal omtrent halvparten så stor ",
          {
            "term": "baandbredde",
            "text": "båndbredde"
          },
          " som et AM-signal med det samme lydsignalet?"
        ]
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Bare ett av de to sidebåndene sendes ut."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Bærebølgen fjernes, og den tar halve båndbredden."
          ],
          "feedback": [
            "Bærebølgen fjernes også, men den er én enkelt frekvens og tar nesten ingen båndbredde. Det er det manglende sidebåndet som halverer bredden."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Lyden komprimeres til halve frekvensområdet først."
          ],
          "feedback": [
            "Lydens frekvensområde endres ikke. Lyden overføres med samme frekvensinnhold som i AM."
          ]
        },
        {
          "id": "o4",
          "content": [
            "SSB bruker frekvensmodulasjon i stedet."
          ],
          "feedback": [
            "SSB er en form for amplitudemodulasjon, ikke frekvensmodulasjon."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "Et AM-signal har to sidebånd, ett på hver side av bærebølgen, og hvert av dem inneholder all informasjonen. AM-signalet blir derfor dobbelt så bredt som den høyeste lydfrekvensen.",
        "SSB sender bare det ene sidebåndet, og bærebølgen er også fjernet. Båndbredden blir omtrent lik lydens båndbredde, typisk rundt 3 kHz for tale."
      ],
