      "context": [
        [
          "Blokkskjemaet viser en enkel ",
          {
            "term": "sender",
            "text": "sender"
          },
          " for morsetelegrafi (CW). Du skal bestemme hvilket trinn morsenøkkelen skal slå signalet av og på i."
        ]
      ],
      "stem": [
        [
          "Hvor er det mest hensiktsmessig å koble inn morsenøkkelen for direkte nøkling med lav ",
          {
            "term": "spenning",
            "text": "spenning"
          },
          " og ",
