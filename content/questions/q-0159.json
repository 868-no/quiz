      "learning_objective": "Vite at en integrert spenningsregulator trenger avkoblingskondensatorer for ikke å oscillere.",
      "priority": "normal",
      "context": [
        [
          "En radioamatør bygger en strømforsyning på ",
          {
            "q": 12,
            "u": "V"
          },
          " med en integrert ",
          {
            "term": "spenningsregulator",
            "text": "spenningsregulator"
          },
          " av typen 7812 med tre bein: inngang, jord og utgang. Regulatoren er koblet rett mellom ",
          {
            "term": "glattekondensator",
            "text": "glattekondensatoren"
          },
          " og utgangsklemmene uten andre komponenter, og glattekondensatoren sitter et stykke unna. På utgangen ser han en høyfrekvent svingning oppå ",
          {
            "term": "likespenning",
            "text": "likespenningen"
          },
          "."
        ]
      ],
      "stem": [
        "Hvilket tiltak vil mest sannsynlig fjerne svingningen?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Sette små kondensatorer med lav induktans tett inntil regulatorens inngang og utgang."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Bytte glattekondensatoren med en som har mye større kapasitans."
          ],
          "feedback": [
            [
              "En større ",
              {
                "term": "elektrolyttkondensator",
                "text": "elektrolyttkondensator"
              },
              " langt unna hjelper lite mot høyfrekvente svingninger. Den har selv induktans, og ledningene til regulatoren gir mer."
            ]
          ]
        },
        {
          "id": "o3",
          "content": [
            "Sette en spole i serie med utgangen fra regulatoren."
          ],
          "feedback": [
            [
              "En ",
              {
                "term": "spole",
                "text": "spole"
              },
              " ",
              {
                "term": "seriekobling",
                "text": "i serie"
              },
              " legger til induktans i utgangen og gjør det heller lettere for regulatoren å svinge."
            ]
          ]
        },
        {
          "id": "o4",
          "content": [
            "Øke spenningen inn til regulatoren med noen volt."
          ],
          "feedback": [
            [
              "Svingningen skyldes ikke for lav inngangsspenning. Høyere ",
              {
                "term": "spenning",
                "text": "spenning"
              },
              " gir bare mer varme i regulatoren."
            ]
          ]
        }
      ],
      "correct": [
