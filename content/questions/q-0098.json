      ],
      "learning_objective": "Regne ut et tredjeordens blandingsprodukt av typen 2·f1 − f2.",
      "priority": "normal",
      "context": [
        [
          "Et ",
          {
            "term": "blander",
            "text": "blandetrinn"
          },
          " i en sender får inn to signaler, f1 = ",
          {
            "q": 8,
            "u": "MHz"
          },
          " og f2 = ",
          {
            "q": 6,
            "u": "MHz"
          },
          ". Fordi blanderen ikke er lineær, inneholder utgangen også produkter av typen m·f1 ± n·f2, der m og n er hele tall."
        ]
      ],
      "stem": [
        "På hvilken frekvens ligger tredjeordensproduktet 2·f1 − f2?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            {
              "q": 10,
              "u": "MHz"
            }
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            {
              "q": 14,
              "u": "MHz"
            }
          ],
          "feedback": [
            "Det er summen f1 + f2, et andreordens produkt."
          ]
        },
        {
          "id": "o3",
          "content": [
            {
              "q": 4,
              "u": "MHz"
            }
          ],
          "feedback": [
            "Det er 2·f2 − f1. Du har byttet om f1 og f2."
          ]
        },
        {
          "id": "o4",
          "content": [
            {
              "q": 2,
              "u": "MHz"
            }
          ],
          "feedback": [
            "Det er differansen f1 − f2, et andreordens produkt."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          {
            "math": [
              "2",
              "·",
              "f_1",
              "−",
