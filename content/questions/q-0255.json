        "vhf-utbredelse"
      ],
      "learning_objective": "Forklare at knivseggdiffraksjon kan gi forbindelse forbi en skarp fjellkant på VHF.",
      "priority": "normal",
      "context": [
        "To stasjoner på 2 m ligger på hver sin side av en skarp fjellrygg og ser ikke hverandre. Likevel får de forbindelse."
      ],
      "stem": [
        "Hva kan forklare dette?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Diffraksjon over den skarpe fjellkanten."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Jordbølgen følger terrenget over fjellet."
          ],
          "feedback": [
            "På 2 m dempes jordbølgen nesten med en gang. Den er nyttig under om lag 2 MHz."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Signalet går rett gjennom fjellet."
          ],
          "feedback": [
            "Fjell slipper i praksis ikke VHF-signaler gjennom. Signalet går over kanten og bøyes ned på den andre siden."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Meteorspredning."
          ],
          "feedback": [
            "Meteorspredning gir korte glimt av forbindelse over lange avstander når meteorer brenner opp. Det forklarer ikke en stabil forbindelse forbi en fjellrygg."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "Når bølger passerer en skarp kant, spres de ut bak kanten, også inn i skyggen av den. Dette kalles diffraksjon, og over en fjelltopp gjerne knivseggdiffraksjon. Det gjelder også radiobølger over 70 MHz.",
        "Slik kan stasjoner som terrenget skjuler for hverandre, likevel nå hverandre."
      ],
