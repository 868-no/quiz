        "demodulering"
      ],
      "learning_objective": "Forstå hvordan utgangen fra en FM-diskriminator varierer med frekvensen.",
      "priority": "exam_important",
      "context": [
        [
          "En ",
          {
            "term": "forholdsdetektor",
            "text": "forholdsdetektor"
          },
          " brukes som FM-demodulator. Detektorens avstemte krets er stilt inn på midten av MF-kanalen."
        ]
      ],
      "stem": "Hva er utgangsspenningen når et umodulert MF-signal ligger nøyaktig på senterfrekvensen?",
      "options": [
        {
          "id": "o1",
          "content": [
            "Null, fordi de to likerettede spenningene er like store med motsatt polaritet"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Størst mulig positiv spenning, fordi kretsen er i resonans"
          ],
          "feedback": [
            "Ved resonans balanserer de to halvdelene hverandre. Utgangen blir positiv eller negativ først når frekvensen avviker."
          ]
        },
        {
          "id": "o3",
          "content": [
            "En vekselspenning med samme frekvens som mellomfrekvensen"
          ],
          "feedback": [
            "Diodene og kondensatorene likeretter MF-signalet. Utgangen følger frekvensavviket, ikke selve mellomfrekvensen."
          ]
        },
        {
          "id": "o4",
          "content": [
            "En likespenning som er proporsjonal med signalstyrken"
          ],
          "feedback": [
            "Forholdsdetektoren er lite følsom for amplitudeendringer. Utgangen avhenger av frekvensavviket."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "En avstemt krets gir 90° faseforskyvning ved senterfrekvensen, slik at de to diodene får like store spenninger. De likerettede spenningene opphever hverandre, og utgangen blir null.",
        "Over senterfrekvensen blir den ene spenningen størst, under blir den andre størst. Nær senterfrekvensen varierer utgangen tilnærmet lineært med frekvensavviket, og det er lyden. Utgangen kan også brukes som avstemmingsindikator."
      ],
      "glossary_after_answer": [
        "forholdsdetektor"
      ],
