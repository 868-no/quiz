          "content": [
            {
              "q": 144.7125,
              "u": "MHz",
              "digits": 4
            }
          ],
          "feedback": [
            "Dette ville vært frekvensen med N = 11 577. Hvert trinn i N flytter frekvensen med 12,5 kHz."
          ]
        }
      ],
      "correct": [
