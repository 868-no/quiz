      "learning_objective": "Forstå hvordan tapsresistansen i spolen påvirker dynamisk resistans og Q-faktor i en parallellkrets.",
      "priority": "exam_important",
      "context": [
        [
          "I en parallellavstemt krets er nesten alle tap samlet i en liten serieresistans R i spoletråden. L og C holdes uendret, og resonansfrekvensen er den samme."
        ]
      ],
      "stem": [
        "Spolen byttes ut med en av samme induktans, men laget av tykkere tråd, slik at R blir halvparten så stor. Hva skjer?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Den dynamiske resistansen og Q-faktoren øker."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Den dynamiske resistansen og Q-faktoren minker."
          ],
          "feedback": [
            "Mindre tap gir mer fullstendig oppheving av strømmene i L og C. Da øker impedansen ved resonans, ikke omvendt."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Den dynamiske resistansen minker, mens Q-faktoren øker."
          ],
          "feedback": [
            "Den dynamiske resistansen er omvendt proporsjonal med R. Med halvert R dobles den."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Ingenting endres, fordi L og C er de samme."
          ],
          "feedback": [
            "Både impedansen ved resonans og Q-faktoren avhenger av tapene, ikke bare av L og C."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Den resistive impedansen til en parallellkrets ved resonans kalles ",
          {
            "term": "dynamisk-resistans",
            "text": "dynamisk resistans"
          },
          ":"
        ],
        {
          "steps": [
            [
              {
                "math": [
                  "R_D",
                  "=",
                  {
                    "frac": [
                      [
                        "L"
                      ],
                      [
                        "C",
                        "·",
                        "R"
                      ]
                    ]
                  }
                ]
              }
            ],
            [
              "Halvert R gir dobbel R_D. Samtidig er Q = X_L / R, så også Q dobles."
            ]
          ]
        },
        "Lave tap gir altså både høyere impedans ved resonans og en skarpere resonanskurve."
      ],
