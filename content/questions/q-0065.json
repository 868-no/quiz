      "learning_objective": "Bruke strømforsterkningen til å finne kollektorstrømmen ut fra basisstrømmen.",
      "priority": "exam_important",
      "context": [
        [
          "En ",
          {
            "term": "transistor",
            "text": "NPN-transistor"
          },
          " har ",
          {
            "term": "stromforsterkning",
            "text": "strømforsterkning"
          },
          " β = 120. Den er forspent slik at basisstrømmen er ",
          {
            "q": 50,
            "u": "µA"
          },
          ", og den arbeider i det lineære området."
        ]
      ],
      "stem": [
        "Omtrent hvor stor er kollektorstrømmen?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            {
              "q": 6,
              "u": "mA"
            }
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            {
              "q": 60,
              "u": "mA"
            }
          ],
          "feedback": [
            "Sjekk prefiksene: 120 · 50 µA = 6000 µA, som er 6 mA, ikke 60 mA."
          ]
        },
        {
          "id": "o3",
          "content": [
            {
              "q": 0.6,
              "u": "mA"
            }
          ],
          "feedback": [
            "Sjekk prefiksene: 120 · 50 µA = 6000 µA, som er 6 mA."
          ]
        },
        {
          "id": "o4",
          "content": [
            {
              "q": 0.42,
              "u": "µA"
            }
          ],
          "feedback": [
            "Her er basisstrømmen delt på β. Kollektorstrømmen er β ganger større enn basisstrømmen, ikke mindre."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "Strømforsterkningen er forholdet mellom kollektorstrøm og basisstrøm:",
        {
          "steps": [
            [
              {
                "math": [
                  "I_C",
                  "=",
                  "β",
                  "·",
                  "I_B",
                  "=",
                  "120",
                  "·",
                  {
                    "q": 50,
                    "u": "µA"
                  },
                  "=",
                  {
                    "q": 6000,
                    "u": "µA"
                  },
                  "=",
                  {
                    "q": 6,
                    "u": "mA"
                  }
                ]
              }
            ]
          ]
        },
        [
          "Emitterstrømmen er summen av de to, altså ",
          {
