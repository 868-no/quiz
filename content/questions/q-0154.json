        "forspenningsklasser"
      ],
      "learning_objective": "Kjenne igjen klasse AB ut fra hvilestrøm og ledevinkel.",
      "priority": "normal",
      "context": [
        [
          "En ",
          {
            "term": "transistor",
            "text": "transistor"
          },
          " i en ",
          {
            "term": "forsterker",
            "text": "forsterker"
          },
          " er ",
          {
            "term": "forspenning",
            "text": "forspent"
          },
          " slik at det går en liten ",
          {
            "term": "hvilestrom",
            "text": "hvilestrøm"
          },
          " også uten signal. Ved svake signaler leder den gjennom hele ",
          {
            "term": "periode",
            "text": "perioden"
          },
          ". Ved sterke signaler sperrer den i en del av perioden, men i mindre enn en halv periode."
        ]
      ],
      "stem": [
        "Hvilken forspenningsklasse er dette?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Klasse AB"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Klasse A"
          ],
          "feedback": [
            "I klasse A leder transistoren hele perioden også ved full utstyring. Det krever en stor hvilestrøm, som må være minst like stor som halve toppstrømmen."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Klasse B"
          ],
          "feedback": [
            "I klasse B er transistoren forspent akkurat på grensen til å lede. Det går nesten ingen hvilestrøm, og den leder bare i den ene halvperioden."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Klasse C"
          ],
          "feedback": [
            "I klasse C er transistoren forspent forbi sperregrensen. Den leder i mindre enn en halv periode, og det går ingen hvilestrøm."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Klassene skilles på hvor stor del av perioden transistoren leder:"
        ],
        {
          "steps": [
            [
              "Klasse A: hele perioden (360°), stor hvilestrøm."
            ],
            [
              "Klasse AB: mer enn en halv, men mindre enn en hel periode; liten hvilestrøm."
            ],
            [
              "Klasse B: omtrent en halv periode (180°); nesten ingen hvilestrøm."
            ],
            [
              "Klasse C: mindre enn en halv periode; ingen hvilestrøm."
            ]
          ]
        },
        [
          "Klasse AB er et kompromiss: Den lille hvilestrømmen fjerner mye av forvrengningen rundt nullgjennomgangen som klasse B gir, men trinnet blir langt mindre varmt enn i ",
          {
            "term": "forsterkerklasse",
            "text": "klasse A"
          },
          ". Det er vanlig i ",
          {
            "term": "push-pull",
            "text": "push-pull-trinn"
          },
          "."
        ]
      ],
      "glossary_after_answer": [
        "hvilestrom"
      ],
