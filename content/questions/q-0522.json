      "stem": [
        "En stasjon forteller at den kjører QRP. Hva betyr det?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "At den sender med lav effekt."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "At den sender morse med lav hastighet."
          ],
          "feedback": [
            "Det er QRS. QRP betyr lav sendereffekt."
          ]
        },
        {
          "id": "o3",
          "content": [
            "At den er plaget av støy."
          ],
          "feedback": [
            "Det er QRN. QRP betyr lav sendereffekt."
