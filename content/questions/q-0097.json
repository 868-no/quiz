      "learning_objective": "Forstå at en liten reduksjon av driveffekten til en lineær forsterker gir mye mindre ulinearitet og harmoniske.",
      "priority": "exam_important",
      "context": [
        [
          "Du har avstemt ",
          {
            "term": "sender",
            "text": "senderen"
          },
          " og et eksternt lineært ",
          {
            "term": "sluttforsterker",
            "text": "sluttrinn"
          },
          " for størst mulig utgangseffekt. En annen radioamatør melder at han hører svake ",
          {
            "term": "harmoniske",
            "text": "harmoniske signaler"
          },
          " fra deg på et høyere bånd."
        ]
      ],
      "stem": [
        "Hvilket enkelt tiltak gir ofte stor forbedring, uten at signalet ditt blir merkbart svakere hos fjerne stasjoner?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Skru ned driveffekten litt, slik at forsterkeren blir mer lineær."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Skru opp driveffekten, slik at forsterkeren går helt i metning."
          ],
          "feedback": [
            [
              {
                "term": "metning",
                "text": "Metning"
              },
              " betyr at forsterkeren klipper signalet. Det gir sterkere harmoniske signaler, ikke svakere."
            ]
          ]
        },
        {
          "id": "o3",
          "content": [
            "Ta ut lavpassfilteret, slik at du slipper tapet i det."
          ],
          "feedback": [
            [
              {
                "term": "lavpassfilter",
