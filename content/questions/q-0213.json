        "s6-20"
      ],
      "topic_ids": [
        "demodulering"
      ],
      "learning_objective": "Forklare prinsippet for flankedetektering av FM og hvorfor metoden sjelden brukes.",
      "priority": "normal",
      "context": [
        [
          "Et ",
          {
            "term": "frekvensmodulasjon",
            "text": "FM"
          },
          "-signal sendes gjennom en ",
          {
            "term": "avstemt-krets",
            "text": "avstemt krets"
          },
          " der ",
          {
            "term": "resonans",
            "text": "resonansfrekvensen"
          },
          " ligger litt ved siden av ",
          {
            "term": "mellomfrekvens",
            "text": "mellomfrekvensen"
          },
          ". Deretter følger en vanlig ",
          {
            "term": "amplitudemodulasjon",
            "text": "AM"
          },
          "-detektor. Dette kalles flankedetektering."
        ]
      ],
      "stem": "Hvorfor kommer det lyd ut av denne koblingen?",
      "options": [
        {
          "id": "o1",
          "content": [
            "Signalet ligger på skrå del av resonanskurven, så frekvensendringer blir til amplitudeendringer"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Signalet ligger på toppen av resonanskurven, så frekvensendringer gir størst mulig utslag"
          ],
          "feedback": [
            "På toppen er kurven nesten flat. Små frekvensendringer gir da nesten ingen endring i amplituden."
          ]
        },
        {
          "id": "o3",
          "content": [
            "AM-detektoren likeretter signalet og gir en spenning som er proporsjonal med frekvensen"
          ],
          "feedback": [
            "En AM-detektor reagerer på amplituden, ikke på frekvensen. Det er den avstemte kretsen som gjør om frekvens til amplitude."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Den avstemte kretsen fjerner bærebølgen, så detektoren bare får med seg sidebåndene"
          ],
          "feedback": [
            [
              "Kretsen er ikke laget for å fjerne ",
              {
                "term": "baerebolge",
                "text": "bærebølgen"
              },
              ". Hele FM-signalet ligger på flanken og blir bare dempet mer eller mindre."
            ]
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Et stykke unna ",
          {
            "term": "resonans",
            "text": "resonansen"
          },
          " ligger kretsen på flanken, der dempingen endres raskt med frekvensen. Når FM-signalet svinger fram og tilbake i frekvens, varierer derfor amplituden etter kretsen i takt med lyden, og en vanlig AM-detektor kan hente den ut."
        ],
        [
          "Metoden er enkel, men brukes sjelden. Flanken er ikke rett, så lyden blir forvrengt, og ",
          {
            "term": "demodulator",
            "text": "detektoren"
          },
          " reagerer også på amplitudestøy og fading. Derfor brukes heller ",
          {
            "term": "diskriminator",
            "text": "diskriminatorer"
          },
          ", forholdsdetektorer eller ",
          {
            "term": "faselaast-sloyfe",
            "text": "PLL"
          },
          "-detektorer."
        ]
      ],
