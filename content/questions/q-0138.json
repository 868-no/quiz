      ],
      "topic_ids": [
        "spoler"
      ],
      "learning_objective": "Kjenne hvordan antall vindinger, diameter og avstand mellom vindingene påvirker induktansen til en luftspole.",
      "priority": "normal",
      "context": [
        [
          "En luftspole er viklet med 20 vindinger tett inntil hverandre på et plastrør med diameter ",
          {
            "q": 2,
            "u": "cm"
          },
          ". Du ønsker større ",
          {
            "term": "induktans",
            "text": "induktans"
          },
          " uten å bruke kjerne."
        ]
      ],
      "stem": [
        "Hvilken endring vil gi større induktans?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Vikle flere vindinger tett på det samme røret"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Trekke vindingene fra hverandre så spolen blir lengre"
          ],
          "feedback": [
            "Når vindingene får større avstand, blir den magnetiske koblingen mellom dem svakere, og induktansen minker."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Vikle de samme 20 vindingene på et tynnere rør"
          ],
          "feedback": [
            "Mindre diameter gir mindre areal for magnetfeltet, og dermed mindre induktans. Større diameter ville økt den."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Bruke tykkere tråd med samme antall vindinger og samme form"
          ],
          "feedback": [
            [
              "Tykkere tråd gir mindre ",
              {
                "term": "resistans",
                "text": "resistans"
              },
              " i spolen, men endrer induktansen svært lite. Om noe blir den litt mindre."
            ]
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Induktansen til en luftspole øker med antall vindinger (omtrent med kvadratet av antallet når formen er lik) og med diameteren. Den minker når vindingene flyttes lenger fra hverandre."
        ],
        [
          "Enheten er henry: en ",
          {
            "term": "spole",
            "text": "spole"
          },
          " har induktansen 1 H når det induseres 1 V i den mens ",
          {
            "term": "strom",
            "text": "strømmen"
          },
          " endres med 1 A per sekund."
        ]
      ],
