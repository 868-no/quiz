      "topic_ids": [
        "komponentstabilitet",
        "spoler"
      ],
      "learning_objective": "Vite hvordan uønsket magnetisk kobling mellom spoler kan reduseres.",
      "priority": "exam_important",
      "context": [
        [
          "To ",
          {
            "term": "spole",
            "text": "spoler"
          },
          " i hver sin avstemte krets står nær hverandre på samme kretskort, og det oppstår uønsket kobling mellom kretsene."
        ]
      ],
      "stem": [
        "Hvilket tiltak reduserer den magnetiske koblingen mellom spolene uten å svekke kretsene?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Montere spolene med aksene vinkelrett på hverandre, eventuelt i hver sin jordede skjermboks."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Montere spolene parallelt med hverandre og så tett sammen som mulig."
          ],
          "feedback": [
            "Parallelle akser og liten avstand gir sterkest kobling, fordi feltet fra den ene spolen går rett gjennom den andre."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Sette en ekstra spole i serie med den ene, slik at feltene opphever hverandre."
          ],
          "feedback": [
            "En ekstra spole endrer induktansen og lager sitt eget felt, men demper ikke koblingen mellom de opprinnelige spolene."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Legge skjermboksen helt inntil spoleviklingene for best mulig skjerming."
          ],
          "feedback": [
            "En skjerm for tett på spolen tar opp energi fra feltet, slik at Q-faktoren og induktansen reduseres. Det må være god avstand til veggene."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "Magnetfeltet fra en spole følger spoleaksen. Står aksene vinkelrett på hverandre, går lite av feltet fra den ene spolen gjennom den andre, og koblingen blir liten.",
        "Alternativt kan spolen plasseres i en jordet metallboks. På radiofrekvenser brukes tynn aluminium eller kobber. Veggene må ha god avstand fra spolen, ellers induseres strømmer i skjermen som senker Q-faktoren."
      ],
