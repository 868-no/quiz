        "zenerdiode"
      ],
      "learning_objective": "Kjenne til hva en zenerdiode brukes til.",
      "priority": "exam_important",
      "context": [],
      "stem": [
        [
          "Hva er den vanligste bruken av en ",
          {
            "term": "zenerdiode",
            "text": "zenerdiode"
          },
          "?"
        ]
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Å holde en spenning tilnærmet konstant"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Å likerette store strømmer i en strømforsyning"
          ],
          "feedback": [
            "Til likeretting brukes vanlige likeretterdioder i lederetningen."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Å virke som en spenningsstyrt kondensator"
          ],
          "feedback": [
            "Det beskriver en varicap-diode."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Å forsterke svake signaler"
          ],
          "feedback": [
            "En zenerdiode brukes ikke til å forsterke signaler. Til det brukes for eksempel transistorer."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "En zenerdiode kobles i sperreretningen. Ved zenerspenningen øker strømmen kraftig, mens spenningen over dioden holder seg nesten konstant. Derfor brukes den som spenningsreferanse og til enkel spenningsstabilisering.",
        {
          "note": [
            "En seriemotstand må begrense strømmen, og varmetapet i dioden (zenerspenning ganger strøm) må holdes innenfor det dioden tåler."
          ]
        }
      ],
