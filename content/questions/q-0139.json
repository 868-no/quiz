        "spoler"
      ],
      "learning_objective": "Forstå at energien i magnetfeltet til en spole gir en høy indusert spenning når strømmen brytes brått.",
      "priority": "normal",
      "context": [
        [
          "Et relé drives av et batteri på ",
          {
            "q": 12,
            "u": "V"
          },
          " gjennom en bryter. Når bryteren åpnes, ser du en liten gnist mellom kontaktene, og et oscilloskop viser en kortvarig ",
          {
            "term": "spenning",
            "text": "spenning"
          },
          " på flere hundre volt over reléspolen."
        ]
      ],
      "stem": [
        "Hva er årsaken til den høye spenningen?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Spolen prøver å holde strømmen i gang med energien som er lagret i magnetfeltet"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Spolen har ladet seg opp som en kondensator og lades ut gjennom kontaktene"
          ],
          "feedback": [
            [
              "Spolen lagrer ",
              {
                "term": "energi",
                "text": "energien"
              },
              " i et magnetfelt. En ",
              {
                "term": "kondensator",
                "text": "kondensator"
              },
              " lagrer derimot energi i et elektrisk felt. Den høye spenningen i dette tilfellet skyldes at strømmen gjennom spolen forsøkes brutt raskt."
            ]
          ]
        },
        {
          "id": "o3",
          "content": [
            "Batteriet gir en spenningstopp når belastningen plutselig forsvinner"
          ],
          "feedback": [
            "Batteriet leverer omtrent 12 V, men spolen kan indusere en langt høyere spenning når strømmen gjennom den endres raskt. Det er energien som allerede er lagret i magnetfeltet, som skaper spenningstoppen."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Strømmen i spolen øker kraftig i det øyeblikket kontaktene skilles"
          ],
          "feedback": [
            "Strømmen minker når kontaktene skilles. Det er nettopp den raske minkingen som induserer spenningen."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Mens ",
          {
            "term": "strom",
            "text": "strømmen"
          },
          " går, er det lagret energi i magnetfeltet til ",
          {
            "term": "spole",
            "text": "spolen"
          },
          ". Når strømmen brytes, faller feltet sammen, og det induseres en spenning som prøver å holde strømmen i gang. Spenningen er proporsjonal med ",
          {
            "term": "induktans",
            "text": "induktansen"
          },
          " og med hvor raskt strømmen endres:"
        ],
        {
          "steps": [
            [
              {
                "math": [
                  "U",
                  "=",
                  "L",
                  "·",
                  {
                    "frac": [
                      [
                        "ΔI"
                      ],
                      [
                        "Δt"
                      ]
                    ]
                  }
                ]
              }
            ]
          ]
        },
        [
          "Brytes strømmen svært raskt, blir Δt liten og spenningen mye høyere enn batterispenningen. Spenningen slår over mellom kontaktene som en gnist, og den kan ødelegge en ",
          {
            "term": "transistor",
            "text": "transistor"
          },
          " som styrer reléet. Derfor kobles ofte en ",
          {
            "term": "diode",
            "text": "diode"
          },
          " i sperreretning over reléspolen, slik at strømmen får en vei å gå og spenningen begrenses."
        ]
      ],
