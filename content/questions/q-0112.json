      "learning_objective": "Forstå hensikten med automatisk forsterkningskontroll.",
      "priority": "exam_important",
      "context": [
        "Blokkskjemaet viser en superheterodynmottaker. Blokken med spørsmålstegn får en likespenning fra detektoren som øker med styrken på det mottatte signalet."
      ],
      "stem": "Hva er hensikten med denne blokken?",
      "options": [
        {
          "id": "o1",
          "content": [
            "Å redusere forsterkningen ved sterke signaler, slik at lydnivået holdes jevnere"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Å stille mottakeren automatisk inn på den sterkeste stasjonen"
          ],
          "feedback": [
            "Blokken endrer forsterkningen, ikke frekvensen mottakeren er innstilt på."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Å kutte lyden helt når det ikke finnes noe signal"
          ],
          "feedback": [
            "Det er oppgaven til brussperren (squelch)."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Å holde frekvensen til lokaloscillatoren stabil"
          ],
          "feedback": [
            "Blokken styrer MF-forsterkeren, ikke lokaloscillatoren."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Blokken er ",
          {
            "term": "agc",
            "text": "AGC"
          },
          " (automatisk forsterkningskontroll). Et sterkere signal gir en større styrespenning, som senker forspenningen på MF-transistorene og dermed forsterkningen."
        ],
        "Signaler i antennen kan variere fra brøkdeler av en mikrovolt til flere volt, og styrken endrer seg også ved fading. AGC gjør at lydstyrken likevel holder seg nokså jevn."
      ],
