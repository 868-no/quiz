      "learning_objective": "Finne sum- og differansefrekvensen fra blandetrinnet i en sender og vite at det uønskede produktet må filtreres bort.",
      "priority": "exam_important",
      "context": [
        [
          "En HF-sender lager SSB-signalet sitt på ",
          {
            "q": 9.0,
            "u": "MHz",
            "digits": 1
          },
          ". For å komme til 20 m-båndet føres signalet til et ",
          {
            "term": "blander",
            "text": "blandetrinn"
          },
          " sammen med en VFO på ",
          {
            "q": 5.2,
            "u": "MHz"
          },
          "."
        ]
      ],
      "stem": [
        "Hvilke to hovedprodukter kommer ut av blandetrinnet?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            {
              "q": 14.2,
              "u": "MHz"
            },
            " og ",
            {
              "q": 3.8,
              "u": "MHz"
            }
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            {
              "q": 14.2,
              "u": "MHz"
            },
            " og ",
            {
              "q": 9.0,
              "u": "MHz",
              "digits": 1
            }
          ],
          "feedback": [
            "Rester av inngangssignalet kan lekke gjennom, men hovedproduktene er summen og differansen av de to frekvensene."
          ]
        },
        {
          "id": "o3",
          "content": [
            {
              "q": 18.0,
              "u": "MHz",
              "digits": 1
            },
            " og ",
            {
              "q": 10.4,
              "u": "MHz"
            }
          ],
          "feedback": [
            "Dette er de andre harmoniske av hvert av signalene. Et blandetrinn lager først og fremst summen og differansen."
          ]
        },
        {
          "id": "o4",
          "content": [
            {
              "q": 7.1,
              "u": "MHz"
            },
            " og ",
            {
              "q": 14.2,
              "u": "MHz"
            }
          ],
          "feedback": [
            "Summen er riktig, men differansen mellom 9,0 MHz og 5,2 MHz er 3,8 MHz."
          ]
        }
      ],
      "correct": [
