      "topic_ids": [
        "frekvensstabilitet"
      ],
      "learning_objective": "Forstå at varierende forsyningsspenning til oscillatoren gir frekvensendringer, og at en egen stabilisert forsyning til oscillatoren løser det.",
      "priority": "normal",
      "context": [
        [
          "Du sender ",
          {
            "term": "frekvensmodulasjon",
            "text": "FM"
          },
          " fra en hjemmebygget 2 m-stasjon i bilen. ",
          {
            "term": "oscillator",
            "text": "Oscillatoren"
          },
          " får strøm rett fra den samme forsyningsledningen som ",
          {
            "term": "sluttforsterker",
            "text": "sluttrinnet"
          },
          ". Hver gang du trykker inn PTT-knappen, faller ",
          {
            "term": "spenning",
            "text": "spenningen"
          },
          " på ledningen merkbart, og andre stasjoner forteller at ",
          {
            "term": "frekvens",
            "text": "frekvensen"
          },
          " din hopper litt idet du begynner å sende."
        ]
      ],
      "stem": [
        "Hvilket tiltak vil mest sannsynlig fjerne problemet?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Sette inn et bedre lavpassfilter mellom senderen og antennen."
          ],
          "feedback": [
            [
              "Et ",
              {
                "term": "lavpassfilter",
                "text": "lavpassfilter"
              },
              " demper ",
              {
                "term": "harmoniske",
                "text": "harmoniske"
              },
              ". Det kan ikke hindre at selve oscillatorfrekvensen flytter seg når forsyningsspenningen endrer seg."
            ]
          ]
        },
        {
          "id": "o2",
          "content": [
            "Gi oscillatoren en egen, stabilisert spenning fra en regulator som bare forsyner den."
          ],
          "feedback": []
        },
        {
          "id": "o3",
          "content": [
            "Øke utgangseffekten, slik at spenningsfallet får mindre betydning."
          ],
          "feedback": [
            "Mer effekt betyr at sluttrinnet trekker enda mer strøm. Spenningsfallet blir større, og problemet blir verre."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Skru ned mikrofonforsterkningen, slik at deviasjonen blir mindre."
          ],
          "feedback": [
            [
              "Mindre ",
              {
                "term": "deviasjon",
                "text": "deviasjon"
              },
              " gjør signalet smalere, men hoppet skyldes at oscillatoren får varierende spenning, ikke modulasjonen."
            ]
          ]
        }
      ],
      "correct": [
        "o2"
      ],
      "explanation": [
        [
          {
            "term": "kapasitans",
            "text": "Kapasitansen"
          },
          " i aktive komponenter, for eksempel en ",
          {
            "term": "transistor",
            "text": "transistor"
          },
          ", avhenger av spenningen over dem. Når sluttrinnet begynner å trekke strøm og forsyningsspenningen synker, endres derfor oscillatorens ",
          {
            "term": "avstemt-krets",
            "text": "avstemte krets"
          },
          " litt, og frekvensen flytter seg."
        ],
        [
          "Løsningen er å forsyne oscillatoren (og gjerne ",
          {
            "term": "bufferforsterker",
            "text": "bufferforsterkeren"
          },
          " etter den) fra en egen, godt avkoblet ",
          {
            "term": "spenningsregulator",
            "text": "spenningsregulator"
          },
          ". Da holder spenningen seg konstant uansett hvor mye strøm resten av senderen trekker. Oscillatoren og bufferen bør også stå på hele tiden mens stasjonen er i bruk, i stedet for å slås av og på med PTT."
        ],
        [
          "På CW gir den samme feilen ",
          {
            "term": "kvitter",
            "text": "kvitter"
          },
          " i starten av hvert tegn."
        ]
      ],
