      ],
      "stem": [
        [
          "Avstanden mellom platene reduseres til halvparten. Hva skjer med ",
          {
            "term": "kapasitans",
            "text": "kapasitansen"
          },
          "?"
        ]
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Den blir omtrent dobbelt så stor."
          ],
