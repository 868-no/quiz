          },
          " er koblet til en vekselspenningskilde. Induktansen holdes konstant."
        ]
      ],
      "stem": [
        [
          "Frekvensen dobles. Hva skjer med den ",
          {
            "term": "induktiv-reaktans",
            "text": "induktive reaktansen"
          },
          "?"
        ]
      ],
      "options": [
