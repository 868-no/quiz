          ]
        },
        {
          "id": "o3",
          "content": [
            "Den er uendret."
          ],
          "feedback": [
            "Resistansen i en ideell motstand er uavhengig av frekvensen, men reaktansen til en spole er det ikke."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Den blir fire ganger så stor."
          ],
          "feedback": [
            "Reaktansen øker i samme forhold som frekvensen, ikke med kvadratet av den."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          {
            "math": [
              "X_L",
              "=",
              "2",
