        "dioder"
      ],
      "learning_objective": "Vite hvilken polaritet en ledende silisiumdiode har, og omtrent hvor stort spenningsfallet over den er.",
      "priority": "exam_important",
      "context": [
        [
          "En ",
          {
            "term": "diode",
            "text": "silisiumdiode"
          },
          " har anoden på P-siden og katoden på N-siden."
        ]
      ],
      "stem": [
        "Hva er typisk riktig når dioden leder strøm i lederetningen?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Anoden er mer positiv enn katoden, og spenningsfallet over dioden er ca. 0,6–0,7 V."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Katoden er mer positiv enn anoden."
          ],
          "feedback": [
            "Da er dioden forspent i sperreretningen. Sperresjiktet blir bredere, og det går nesten ingen strøm."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Polariteten spiller ingen rolle; dioden leder begge veier."
          ],
          "feedback": [
            "En diode leder bare i én retning. Det er nettopp derfor den kan brukes som likeretter."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Anoden er mer positiv enn katoden, og spenningsfallet over dioden er ca. 6–7 V."
          ],
          "feedback": [
            "Spenningsfallet over en ledende silisiumdiode er omtrent en tidel av dette."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Når P-siden (anoden) gjøres positiv i forhold til N-siden (katoden), blir barrieren ved overgangen mindre. Dioden er da ",
          {
            "term": "lederetning",
            "text": "forspent i lederetningen"
          },
          "."
        ],
        "Strømmen øker kraftig med spenningen, og ved vanlig drift ligger det omtrent 0,6–0,7 V over en silisiumdiode. Det er ingen helt skarp terskel; den nøyaktige verdien avhenger av strøm og temperatur. Med motsatt polaritet blir sperresjiktet bredere, og bare en svært liten lekkasjestrøm går."
      ],
