        "felteffekttransistorer"
      ],
      "learning_objective": "Vite hvordan statisk følsomme komponenter som MOSFET skal håndteres.",
      "priority": "normal",
      "context": [
        [
          "Du skal bytte en ",
          {
            "term": "felteffekttransistor",
            "text": "MOSFET"
          },
          " i ",
          {
            "term": "forforsterker",
            "text": "forforsterkeren"
          },
          " i en ",
          {
            "term": "mottaker",
            "text": "mottaker"
          },
          ". Den nye komponenten ligger i en ledende antistatisk pose. Mottakeren er koblet fra strømnettet."
        ]
      ],
      "stem": [
        "Hva er den beste fremgangsmåten?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Bruk et jordet antistatisk armbånd, og ta komponenten ut av posen først når den skal monteres."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Ta komponenten ut av posen i god tid, slik at statisk ladning i posen rekker å lekke bort."
          ],
          "feedback": [
            "Posen beskytter komponenten. Den er svakt ledende og holder alle beina på samme potensial. Komponenten bør ligge i posen til den skal monteres."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Bruk et armbånd koblet rett til jord uten seriemotstand, så ladningen ledes bort raskest mulig."
          ],
          "feedback": [
            [
              "Armbåndet skal ha en seriemotstand på noen megaohm. Den begrenser ",
              {
                "term": "strom",
                "text": "strømmen"
              },
              " gjennom kroppen om du skulle komme borti noe spenningsførende."
            ]
          ]
        },
        {
          "id": "o4",
          "content": [
            "Det trengs ingen særlige tiltak, fordi gate tåler flere tusen volt uten skade."
          ],
          "feedback": [
            "Det isolerende laget under gate er svært tynt. Noen få titalls volt kan slå det igjennom, og en person kan lett være ladet opp til flere tusen volt."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "I en MOSFET er gate skilt fra kanalen med et ekstremt tynt isolerende lag. Det gir svært høy inngangsimpedans, men laget kan ødelegges av ",
          {
            "term": "spenning",
            "text": "spenninger"
          },
          " ned mot 5–10 V. Statisk elektrisitet fra kroppen kan være mange kilovolt, selv om du ikke kjenner noe."
        ],
        [
          "Et antistatisk armbånd kobles til et jordpunkt gjennom en ",
          {
            "term": "motstand",
            "text": "motstand"
          },
          " på noen megaohm. Det holder deg på samme potensial som arbeidsflaten uten å gi en farlig strømvei. Ikke bruk armbåndet når du arbeider på utstyr som er tilkoblet og har høy spenning."
        ]
      ],
