      "section_ids": [
        "s2-16"
      ],
      "topic_ids": [
        "effekt",
        "ohms-lov"
      ],
      "learning_objective": "Forstå at størst effekt avgis i lasten når lastresistansen er lik kildens indre resistans.",
      "priority": "normal",
      "context": [
        [
          "En spenningskilde har en kildespenning (EMS) på ",
          {
            "q": 12,
            "u": "V"
          },
          " og en indre ",
          {
            "term": "resistans",
            "text": "resistans"
          },
          " på ",
          {
            "q": 4,
            "u": "Ω"
          },
          ". En justerbar lastmotstand kobles mellom polene."
        ]
      ],
      "stem": [
        [
          "Ved hvilken lastresistans blir ",
          {
            "term": "effekt",
            "text": "effekten"
          },
          " som avgis i lastmotstanden, størst?"
        ]
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            {
              "q": 4,
              "u": "Ω"
            }
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            {
              "q": 2,
              "u": "Ω"
            }
          ],
          "feedback": [
            "Med 2 Ω går det 2 A, og lasten får 2 A · 2 A · 2 Ω = 8 W. Det er mindre enn ved 4 Ω, fordi en større del av effekten nå går tapt i kilden."
          ]
        },
        {
          "id": "o3",
          "content": [
            {
              "q": 8,
              "u": "Ω"
            }
          ],
          "feedback": [
            [
              "Med 8 Ω går det 1 A, og lasten får 1 A · 1 A · 8 Ω = 8 W. ",
              {
                "term": "spenning",
                "text": "Spenningen"
              },
              " over lasten er høyere, men strømmen er blitt for liten."
            ]
          ]
        },
        {
          "id": "o4",
          "content": [
            {
              "q": 0.1,
              "u": "Ω"
            }
          ],
          "feedback": [
            [
              "Nær kortslutning blir strømmen størst, men nesten all spenning ligger da over den ",
              {
                "term": "indre-resistans",
                "text": "indre resistansen"
              },
              ". Lasten får nesten ingen effekt."
            ]
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          {
            "term": "strom",
            "text": "Strømmen"
          },
          " er ",
          {
            "math": [
              "I",
              "=",
              {
                "frac": [
                  [
                    "U"
                  ],
                  [
                    "R",
                    "+",
                    "r"
                  ]
                ]
              }
            ]
          },
          " og effekten i lasten ",
          {
            "math": [
              "P",
              "=",
              "I^2",
              "·",
              "R"
            ]
          },
          ". Liten R gir stor strøm, men lav spenning over lasten; stor R gir høy spenning, men liten strøm. Effekten blir størst midt imellom, når R = r."
        ],
        {
          "steps": [
            [
              "R = 2 Ω: I = 2 A, P = 8 W"
            ],
            [
              "R = 4 Ω: I = 1,5 A, P = 9 W"
            ],
            [
              "R = 8 Ω: I = 1 A, P = 8 W"
            ]
          ]
        },
        {
          "note": [
            "Ved ",
            {
              "term": "tilpasning",
              "text": "tilpasning"
            },
            " (R = r) går like mye effekt tapt i kilden som i lasten, så ",
            {
              "term": "virkningsgrad",
              "text": "virkningsgraden"
            },
            " er bare 50 %. Dette kalles prinsippet om maksimal effektoverføring og gjelder for en spenningskilde med fast indre resistans. I radiosendere brukes impedanstilpasning også for å gi ",
            {
              "term": "sluttforsterker",
              "text": "sluttrinnet"
            },
            " riktig belastning og for å begrense refleksjoner i antennesystemet. Det betyr ikke at ",
            {
              "term": "sender",
              "text": "senderens"
            },
            " indre resistans nødvendigvis er ",
            {
              "q": 50,
              "u": "Ω"
            },
            "."
          ]
        }
      ],
