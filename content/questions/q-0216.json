        "s6-13"
      ],
      "topic_ids": [
        "superheterodyn"
      ],
      "learning_objective": "Kjenne kravene til signalet fra lokaloscillatoren i en mottaker.",
      "priority": "normal",
      "context": [
        [
          "I en ",
          {
            "term": "superheterodyn",
            "text": "superheterodynmottaker"
          },
          " blandes antennesignalet med signalet fra ",
          {
            "term": "lokaloscillator",
            "text": "lokaloscillatoren"
          },
          ". ",
          {
            "term": "oscillator",
            "text": "Oscillatoren"
          },
          " kan for eksempel bygges som en fritt avstembar VFO, med ",
          {
            "term": "faselaast-sloyfe",
            "text": "PLL"
          },
          " eller med ",
          {
            "term": "dds",
            "text": "DDS"
          },
          "."
        ]
      ],
      "stem": "Hvilke egenskaper er viktigst for signalet fra lokaloscillatoren?",
      "options": [
        {
          "id": "o1",
          "content": [
            "Det må være rent, stabilt og avstembart"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Det må være kraftig, rikt på harmoniske og fast i frekvens"
          ],
          "feedback": [
            [
              {
                "term": "harmoniske",
                "text": "Harmoniske"
              },
              " gir ekstra ",
              {
                "term": "intermodulasjon",
                "text": "blandingsprodukter"
              },
              " og falske signaler. Mottakeren må dessuten kunne stilles inn, så frekvensen kan ikke ligge fast."
            ]
          ]
        },
        {
          "id": "o3",
          "content": [
            "Det må være amplitudemodulert, stabilt og avstembart"
          ],
          "feedback": [
            "Modulasjon på lokaloscillatoren blandes inn i mellomfrekvensen og høres som støy eller forvrengning på det ønskede signalet."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Det må være bredbåndet, avstembart og like svakt som antennesignalet"
          ],
          "feedback": [
            [
              "Signalet skal være så smalt og rent som mulig, og vanligvis mye sterkere enn antennesignalet for å styre ",
              {
                "term": "blander",
                "text": "blanderen"
              },
              " riktig."
            ]
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Lokaloscillatoren bestemmer hvilken ",
          {
            "term": "frekvens",
            "text": "frekvens"
          },
          " ",
          {
            "term": "mottaker",
            "text": "mottakeren"
          },
          " tar imot, så den må kunne stilles inn. Driver den, driver også mottakerfrekvensen."
        ],
        [
          "Støy, brum eller modulasjon på oscillatorsignalet blir overført til ",
          {
            "term": "mellomfrekvens",
            "text": "mellomfrekvensen"
          },
          " og høres på det ønskede signalet. Har en PLL eller DDS av dårlig kvalitet falske signaler ved siden av hovedfrekvensen, kan disse også blande kraftige stasjoner utenfor kanalen inn på mellomfrekvensen, der de ikke kan filtreres bort. Derfor trenger oscillatoren ren strømforsyning og god mekanisk stabilitet."
        ]
      ],
