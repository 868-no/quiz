      "learning_objective": "Vite at harmoniske er heltallige multipler av grunnfrekvensen.",
      "priority": "normal",
      "context": [
        [
          "En ",
          {
            "term": "sender",
            "text": "sender"
          },
          " på ",
          {
            "q": 7.05,
            "u": "MHz"
          },
          " har for dårlig filtrering på utgangen, og bølgeformen er ikke helt sinusformet. Den sender derfor også ut svake signaler på andre ",
          {
            "term": "frekvens",
            "text": "frekvenser"
          },
          "."
        ]
      ],
      "stem": [
        [
          "Hvilken av disse frekvensene kan være en ",
          {
            "term": "harmoniske",
            "text": "harmonisk"
          },
          " av senderfrekvensen?"
        ]
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            {
              "q": 21.15,
              "u": "MHz"
            }
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            {
              "q": 10.575,
              "u": "MHz"
            }
          ],
          "feedback": [
            "Dette er 1,5 ganger senderfrekvensen. Harmoniske er hele multipler: 2, 3, 4 … ganger grunnfrekvensen."
          ]
        },
        {
          "id": "o3",
          "content": [
            {
              "q": 3.525,
              "u": "MHz"
            }
          ],
          "feedback": [
            "Dette er halve senderfrekvensen. Harmoniske ligger over grunnfrekvensen, aldri under."
          ]
        },
        {
          "id": "o4",
          "content": [
            {
              "q": 7.1,
              "u": "MHz"
            }
          ],
          "feedback": [
            "Dette er bare en frekvens litt over senderfrekvensen, ikke et helt multiplum av den."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "De ",
          {
            "term": "harmoniske",
            "text": "harmoniske"
          },
          " er heltallige multipler av grunnfrekvensen. Den andre harmoniske av 7,05 MHz er 14,1 MHz, og den tredje er 3 · 7,05 MHz = 21,15 MHz."
        ],
        [
          "Harmoniske oppstår når bølgeformen er forvrengt i forhold til en ren sinus. Et ",
          {
            "term": "lavpassfilter",
            "text": "lavpassfilter"
          },
          " på utgangen av senderen demper dem, slik at de ikke forstyrrer andre brukere."
        ]
      ],
      "glossary_after_answer": [
