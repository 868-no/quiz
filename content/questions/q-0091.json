        "spisseffekt"
      ],
      "learning_objective": "Vite hva en taleprosessor gjør med forholdet mellom gjennomsnitts- og spisseffekt.",
      "priority": "exam_important",
      "context": [],
      "stem": [
        [
          "Hva er den viktigste virkningen av å slå på ",
          {
            "term": "taleprosessor",
            "text": "taleprosessoren"
          },
          " i en SSB-sender?"
        ]
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Gjennomsnittseffekten øker i forhold til spisseffekten."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Spisseffekten øker ut over senderens største effekt."
          ],
          "feedback": [
            "Senderens spisseffekt endres ikke. Prosessoren begrenser toppene slik at de svakere delene av talen kan løftes."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Båndbredden til signalet blir halvert."
          ],
          "feedback": [
            "Båndbredden bestemmes av lydens frekvensområde og filtrene, ikke av taleprosessoren."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Gjennomsnittseffekten går ned, så sluttrinnet blir kaldere."
          ],
          "feedback": [
            "Det er motsatt. Høyere gjennomsnittseffekt gir mer varme i sluttrinnet."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "En taleprosessor begrenser eller komprimerer taletoppene, slik at de svakere delene av talen kan forsterkes mer. Spisseffekten er den samme, men gjennomsnittseffekten blir høyere, og signalet høres kraftigere ut hos mottakeren.",
        "Det kan hjelpe ved svake forbindelser, men sluttrinnet og strømforsyningen belastes mer. For mye prosessering gir dessuten forvrengt lyd."
      ],
      "glossary_after_answer": [
        "taleprosessor"
      ],
