        "motstandskoblinger"
      ],
      "learning_objective": "Forstå at alle grener i en parallellkobling har samme spenning.",
      "priority": "exam_important",
      "context": [
        [
          "Figuren viser tre ulike motstander koblet ",
          {
            "term": "parallellkobling",
            "text": "i parallell"
          },
          " over et batteri på ",
          {
            "q": 12,
            "u": "V"
          },
          "."
        ]
      ],
      "stem": [
        "Hva er riktig om spenningene over de tre motstandene?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Alle tre har like stor spenning over seg, nemlig 12 V."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Den største motstanden har størst spenning over seg."
          ],
          "feedback": [
            "Det gjelder for motstander i serie. I parallell er hver motstand koblet direkte mellom de samme to punktene."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Spenningene over de tre motstandene blir til sammen 12 V."
          ],
          "feedback": [
            "Det er strømmene som summeres i en parallellkobling, ikke spenningene."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Den minste motstanden har størst spenning over seg."
          ],
          "feedback": [
            "Den minste motstanden får størst strøm, men spenningen over den er den samme som over de andre."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "Hver gren er koblet direkte til batteriets to poler, så hver motstand får hele batterispenningen. Det som er forskjellig, er strømmen: etter Ohms lov går det mest strøm gjennom den minste motstanden. Den totale strømmen fra batteriet er summen av grenstrømmene."
      ],
