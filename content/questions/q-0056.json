      ],
      "learning_objective": "Kjenne den piezoelektriske effekten som grunnlaget for kvartskrystaller.",
      "priority": "exam_important",
      "context": [
        [
          "Et ",
          {
            "term": "kvartskrystall",
            "text": "kvartskrystall"
          },
          " gir en elektrisk spenning mellom sideflatene når det bøyes eller trykkes sammen. Omvendt endrer det form litt når det påtrykkes en spenning."
        ]
      ],
      "stem": [
        "Hva kalles denne effekten?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "Den piezoelektriske effekten"
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "Den termoelektriske effekten"
          ],
          "feedback": [
            "Termoelektrisk effekt gir spenning ut fra temperaturforskjeller, ikke mekanisk påkjenning."
          ]
        },
        {
          "id": "o3",
          "content": [
            "Den fotoelektriske effekten"
          ],
          "feedback": [
            "Fotoelektrisk effekt handler om lys som frigjør elektroner, ikke om mekanisk deformasjon."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Selvinduksjon"
          ],
          "feedback": [
            "Selvinduksjon er spenning indusert i en spole av dens eget skiftende magnetfelt."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        [
          "Kvarts er ",
          {
            "term": "piezoelektrisk-effekt",
            "text": "piezoelektrisk"
          },
          ": mekanisk påkjenning gir elektrisk spenning, og elektrisk spenning gir mekanisk formendring."
        ],
        "Påtrykkes en vekselspenning med frekvens lik krystallets mekaniske egenfrekvens, svinger krystallet kraftig, og det oppfører seg elektrisk som en resonanskrets. Effekten brukes også i for eksempel gasstennere."
      ],
