      "stem": [
        "En stasjon avslutter med «LA1XYZ QSY 14200 kHz». Hva betyr det?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "At stasjonen bytter til frekvensen 14200 kHz."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "At stasjonen stenger og frekvensen blir ledig."
          ],
          "feedback": [
            "Det ville vært QRT. QSY betyr at man skifter frekvens."
          ]
        },
        {
          "id": "o3",
          "content": [
            "At stasjonen ber om en bekreftelse på kontakten."
          ],
          "feedback": [
            "Det er QSL. QSY betyr at man skifter frekvens."
          ]
        },
        {
          "id": "o4",
          "content": [
            "At stasjonen spør om frekvensen 14200 kHz er opptatt."
          ],
          "feedback": [
            "For å spørre om frekvensen er opptatt bruker man QRL. QSY betyr at man skifter frekvens."
          ]
        }
      ],
      "correct": [
