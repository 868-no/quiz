      "learning_objective": "Vite hva diplomene DXCC og IOTA går ut på.",
      "priority": "normal",
      "context": [
        "To radioamatører forteller om diplomene de jakter på. Den ene samler til DXCC, den andre til IOTA."
      ],
      "stem": [
        "Hva samler de på?"
      ],
      "options": [
        {
          "id": "o1",
          "content": [
            "DXCC: kontakter med ulike land og områder i verden. IOTA: kontakter med stasjoner på øyer."
          ],
          "feedback": []
        },
        {
          "id": "o2",
          "content": [
            "DXCC: kontakter på flest mulig bånd. IOTA: flest mulig kontakter i én konkurranse."
          ],
          "feedback": [
            "Ingen av diplomene handler om antall bånd eller én konkurranse. DXCC gjelder land og områder, IOTA gjelder øyer."
          ]
        },
        {
          "id": "o3",
          "content": [
            "DXCC: QSL-kort fra stasjoner i USA. IOTA: QSL-kort fra stasjoner i Storbritannia."
          ],
          "feedback": [
            "Diplomene administreres av ARRL og RSGB, men de gjelder kontakter over hele verden."
          ]
        },
        {
          "id": "o4",
          "content": [
            "Begge går ut på å høre flest mulig stasjoner, uten å ha kontakt med dem."
          ],
          "feedback": [
            "Begge krever bekreftede kontakter, for eksempel med QSL-kort eller i LoTW."
          ]
        }
      ],
      "correct": [
        "o1"
      ],
      "explanation": [
        "DXCC (DX Century Club) administreres av ARRL og gis for bekreftede kontakter med minst 100 ulike land og områder. IOTA (Islands on the Air) administreres av RSGB og handler om kontakter med stasjoner på øyer rundt om i verden.",
        [
          "Begge krever at kontaktene er bekreftet, for eksempel med ",
          {
            "term": "qsl-kort",
            "text": "QSL-kort"
          },
          " eller i LoTW."
        ]
      ],
